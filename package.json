{
  "name": "aumbram-events-attribution-commission",
  "version": "1.0.0",
  "private": true,
  "description": "Events -> attribution -> creator commission ledger (Aumbram Backend 3)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:api": "node dist/src/main/api.js",
    "start:worker": "node dist/src/main/worker.js",
    "cli": "node dist/src/main/cli.js",
    "migrate": "node dist/src/main/cli.js migrate",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "demo": "node dist/scripts/demo.js",
    "loadtest": "node dist/loadtest/replay.js"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}