# Dev-only placeholder values, never real secrets. Copy this file to .env
# (git-ignored) and change the values there; docker compose loads .env
# automatically, and host-side tooling reads it via dotenv.
#
# Postgres credentials (used by the `postgres` service and interpolated into
# DATABASE_URL/TEST_DATABASE_URL below for docker compose; keep them in sync
# if you change one).
POSTGRES_USER=aumbram
POSTGRES_PASSWORD=aumbram
POSTGRES_DB=aumbram
POSTGRES_TEST_DB=aumbram_test

APP_KEY=dev_app_key_change_me
INTERNAL_TOKEN=dev_internal_token_change_me

# Host-side (non-docker) connection strings, e.g. `npm test`. Inside compose
# the api/worker/test services build the same URL themselves from the
# POSTGRES_* vars above.
DATABASE_URL=postgres://aumbram:aumbram@localhost:55432/aumbram
TEST_DATABASE_URL=postgres://aumbram:aumbram@localhost:55432/aumbram_test
PORT=8080
LOG_LEVEL=info

# Ingestion limits and backpressure
INGEST_MAX_EVENTS=500
INGEST_MAX_BYTES=1048576
RATE_LIMIT_EVENTS_PER_SEC=10000
RATE_LIMIT_BURST=20000
QUEUE_MAX_DEPTH=200000
QUEUE_MAX_LAG_SECONDS=60
QUEUE_RETRY_AFTER_SECONDS=5

# Worker
WORKER_EVENT_CONSUMERS=2
WORKER_EVENT_BATCH_SIZE=1000
WORKER_ORDER_CONSUMERS=2
WORKER_METRICS_PORT=9091
SWEEP_INTERVAL_SECONDS=0
INVARIANT_CHECK_INTERVAL_SECONDS=60

# Attribution
ATTRIBUTION_RULE_VERSION=v1
